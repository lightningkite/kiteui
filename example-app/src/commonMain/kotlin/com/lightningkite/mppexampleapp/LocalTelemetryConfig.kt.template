package com.lightningkite.mppexampleapp

import com.lightningkite.kiteui.navigation.PageNavigator
import com.lightningkite.kiteui.telemetry.Telemetry
import com.lightningkite.kiteui.telemetry.TelemetryConfig

fun configureTelemetry(navigator: PageNavigator) {
    val telemetry = Telemetry(TelemetryConfig(
        endpoint = "https://otlp-gateway-prod-us-west-0.grafana.net/otlp",
        headers = mapOf("Authorization" to "Basic YOUR_BASE64_ENCODED_CREDENTIALS"),
        serviceName = "kiteui-example-app",
    ))
    telemetry.install(navigator)
}
