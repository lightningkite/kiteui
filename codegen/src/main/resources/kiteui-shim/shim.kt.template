//<group:resources-js>
private fun copyResources(from: Path, to: Path) {
    val source = from.toFile()
    val dest = to.toFile()
    dest.mkdirs()
    source.walkTopDown().filter { it.isFile }.forEach {
        it.copyTo(dest.resolve(it.relativeTo(source)), overwrite = true)
    }
}
